# Copie para .env e ajuste os valores
NODE_ENV=development
PORT=3333

# Banco (bate com o docker-compose.yml da raiz)
DATABASE_URL="postgresql://whisky:whisky@localhost:5432/whiskypub?schema=public"

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Origem do frontend (Vite)
CORS_ORIGIN=http://localhost:5173

# Usuário administrador criado pelo seed
ADMIN_NAME=Julius
ADMIN_EMAIL=admin@whiskypub.com
ADMIN_PASSWORD=TroqueEssaSenha123

# Loja / frete
SHIPPING_FEE=29.90
FREE_SHIPPING_FROM=500

# PIX (dados do recebedor que vão no QR Code)
PIX_KEY=sua-chave-pix@email.com
PIX_MERCHANT_NAME=WHISKY PUB
PIX_MERCHANT_CITY=RECIFE
PIX_EXPIRATION_MINUTES=30
# true = libera o botão "simular pagamento" (desligue em produção)
PIX_SIMULATION=true
